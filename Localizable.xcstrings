    "deleteBin.deleteCannotUndo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items will be moved to the Recently Deleted folder in Photos, where they'll stay for 30 days before being permanently removed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ögeler, Fotoğraflar'daki Son Silinenler klasörüne taşınacak ve kalıcı olarak silinmeden önce 30 gün boyunca saklanacaktır."
          }
        }
      }
    },
