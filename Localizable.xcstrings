      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purgio sees your whole library. Nothing ever leaves your iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Purgio tüm kütüphanenizi görür. Hiçbir şey iPhone'unuzdan çıkmaz."
